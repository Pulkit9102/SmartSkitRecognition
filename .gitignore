# Root .gitignore for Skin Disease Recognition Project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Node
node_modules/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Model files (large)
model/skin_disease_model.h5
model/*.h5

# Generated files
model/class_names.json
model/training_history.json
model/*.png
model/plots/
model/logs/

# Build outputs
frontend/build/
backend/dist/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.pytest_cache/

# Dataset (optional - uncomment if you don't want to commit images)
# dataset/train/
# dataset/validation/
# dataset/test/

# Keep structure but ignore images
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.gif
dataset/**/*.bmp

# Keep README files
!dataset/**/README.md
!dataset/**/README.txt

# Jupyter Notebooks
.ipynb_checkpoints

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
*.swp
*.bak
